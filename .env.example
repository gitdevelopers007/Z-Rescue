# Z-Rescue Environment Configuration
# IBM Z Datathon 2026 | Team: UNI MIND | Event Code: SSF2026

# Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database
DATABASE_URL=sqlite:///./z_rescue.db

# System Mode
# Set to 'demo' for local simulation mode, or 'connected' when connected to an external IBM Z transaction environment
SYSTEM_MODE=demo
IS_DEMO_MODE=true

# Open-Meteo Weather API
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_TTL_SECONDS=1800
WEATHER_TIMEOUT_SECONDS=5.0

# IBM Z Transaction Integration (Adapter Configuration)
IBM_Z_ENDPOINT=https://mock-ibm-z-zos.internal.ibm.com/v1/tx
IBM_Z_API_KEY=
IBM_Z_CORRELATION_PREFIX=Z-RESCUE-TX
IBM_Z_TIMEOUT_SECONDS=3.0
IBM_Z_MAX_RETRIES=2

# Risk Model
MODEL_FILE_PATH=./backend/app/ai/risk_model.joblib
MODEL_METADATA_PATH=./backend/app/ai/model_metadata.json

# Demo Generator Defaults
DEMO_GENERATOR_INTERVAL_SECONDS=5
DEMO_GENERATOR_AUTOSTART=false
